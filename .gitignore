# What this scaffold builds, not what an editor or OS drops beside it —
# those live in ~/.config/git/gitignore_global, not here.

/hush-hush
/dist
coverage.out

node_modules/
.bun-cache/

# Written by the release job, not by hand.
CHANGELOG.md

# Vale's style packages, downloaded by `vale sync`.
/styles/Google/
/styles/proselint/

# The real built SPA — Docker, goreleaser, and CI's own e2e job each
# build it fresh from cmd/hush-hush/web before go:embed reads it for
# real, so it's never worth committing. index.html stays tracked as a
# placeholder (`git log` back to #205: this repo's own original shape
# before #206 scaffolded the real app) so a bare `go build`, with no
# frontend build step first, still compiles — go:embed all:web/build
# needs at least one matching file present.
/cmd/hush-hush/web/build/*
!/cmd/hush-hush/web/build/index.html
/cmd/hush-hush/web/.svelte-kit/
