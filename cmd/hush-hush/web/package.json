{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run copy-changelog && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"copy-changelog": "cp ../../../CHANGELOG.md static/CHANGELOG.md",
		"dev": "bun run copy-changelog && vite dev",
		"format": "biome format --write .",
		"lint": "biome check .",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"screenshots": "bun run e2e/screenshots.ts",
		"test": "bun run test:unit -- --run",
		"test:e2e": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@simplewebauthn/browser": "14.0.0",
		"bits-ui": "2.19.2",
		"dompurify": "3.4.15",
		"marked": "18.0.13"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.10.2",
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "1.63.0",
		"@shadcn/lint": "0.2.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tailwindcss/vite": "4.3.3",
		"jsdom": "30.1.0",
		"oxlint": "1.85.0",
		"svelte": "5.56.1",
		"svelte-check": "4.6.0",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.0.16",
		"vitest": "4.1.11"
	},
	"packageManager": "bun@1.3.14"
}
