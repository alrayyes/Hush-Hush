{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run copy-changelog && bun run copy-license && vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"copy-changelog": "cp ../../../CHANGELOG.md static/CHANGELOG.md",
		"copy-license": "cp ../../../LICENSE static/LICENSE.txt",
		"dev": "bun run copy-changelog && bun run copy-license && vite dev",
		"format": "biome format --write .",
		"generate:api": "openapi-typescript ../../../api/openapi.yaml -o src/lib/api-schema.d.ts && bun scripts/generate-api-limits.ts",
		"generate:api:check": "openapi-typescript ../../../api/openapi.yaml -o src/lib/api-schema.d.ts --check && bun scripts/generate-api-limits.ts --check",
		"lighthouse": "bun run e2e/lighthouse.ts",
		"lint": "biome check .",
		"lint:tailwind": "oxlint -c .oxlintrc.json src",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"screenshots": "bun run e2e/screenshots.ts",
		"test": "bun run test:unit -- --run",
		"test:e2e": "playwright test",
		"test:unit": "vitest"
	},
	"dependencies": {
		"@scure/bip39": "2.4.0",
		"@simplewebauthn/browser": "14.0.0",
		"age-encryption": "0.3.1",
		"bits-ui": "2.19.3",
		"clsx": "2.1.1",
		"svelte-toolbelt": "0.10.6",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.15",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.49.0",
		"@playwright/test": "1.63.0",
		"@shadcn/lint": "0.2.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"jsdom": "30.1.1",
		"lighthouse": "13.5.0",
		"openapi-typescript": "7.13.0",
		"oxlint": "1.86.0",
		"playwright-lighthouse": "4.0.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	},
	"packageManager": "bun@1.3.14",
	"overrides": {
		"cookie": "0.7.2",
		"source-map-js": "1.2.2"
	}
}
